# ==============================================================================
# SOLE Footwear — Vercel Multi-Service Project Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Service Settings
# ------------------------------------------------------------------------------
# Client API Base URL
# - Development: http://127.0.0.1:3001
# - Production (Vercel Multi-Service): /api
VITE_API_URL=/api

# Server SSR API URL (fallback if service binding is not active)
# - Development: http://127.0.0.1:3001
VITE_SERVER_API_URL=http://127.0.0.1:3001

# Nitro Preset for Vercel deployment (handled via vercel.json)
NITRO_PRESET=vercel

# Injected automatically by Vercel via service binding "backend" -> "frontend"
# BACKEND_SERVICE_URL=http://...

# ------------------------------------------------------------------------------
# Backend Service Settings (NestJS + Prisma)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production

# Database Connection (SQLite or PostgreSQL)
DATABASE_URL="file:./prisma/dev.db"

# JWT Authentication
JWT_SECRET="replace-with-a-strong-random-64-character-secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-with-a-strong-random-64-character-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Optional integrations
# REDIS_URL="redis://localhost:6379"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET_NAME="sole-elite-media"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""
