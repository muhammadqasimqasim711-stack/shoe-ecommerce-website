# ==============================================================================
# SOLE Footwear — Frontend Environment Variables
# ==============================================================================

# Client API Base URL
# - Development: http://127.0.0.1:3001
# - Production (Vercel with reverse proxy): /api
# - Production (External backend, e.g. Railway/Render): https://api.yourdomain.com
VITE_API_URL=http://127.0.0.1:3001

# Server SSR API URL (used by TanStack Start / Nitro SSR serverless function)
# - Development: http://127.0.0.1:3001
# - Production: https://api.yourdomain.com
VITE_SERVER_API_URL=http://127.0.0.1:3001

# Nitro Preset for Vercel deployment (set automatically via vercel.json buildCommand)
# NITRO_PRESET=vercel
