{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "./",
      "buildCommand": "NITRO_PRESET=vercel npm run build",
      "outputDirectory": ".vercel/output",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_SERVICE_URL"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "nestjs",
      "buildCommand": "npx prisma generate && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/$1"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend",
        "path": "/uploads/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
